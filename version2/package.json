{
  "name": "food",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js",
    "build": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "e2e": "playwright test",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check ."
  },
  "dependencies": {
    "@kobalte/core": "^0.13.13",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.3",
    "nanoid": "^6.0.1",
    "nitro": "3.0.260610-beta",
    "openid-client": "6.8.5",
    "pg": "8.23.0",
    "solid-js": "^1.9.14",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "8.21.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.5",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
