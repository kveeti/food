{
  "tasks": {
    "dev": "make dev",
    "start": "deno run --allow-env --allow-net --allow-read=drizzle main.ts",
    "test": "deno test --permit-no-files",
    "e2e": "deno --allow-all playwright test",
    "check": "deno fmt --check && deno lint && deno check main.ts dev-idp/main.ts drizzle.config.ts playwright.config.ts tests/home.spec.ts && deno task test"
  },
  "imports": {
    "@playwright/test": "npm:@playwright/test@1.61.1",
    "@std/assert": "jsr:@std/assert@1",
    "@types/pg": "npm:@types/pg@^8.23.1",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-rc.4",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-rc.4",
    "hono": "npm:hono@^4.13.5",
    "jose": "npm:jose@6.2.10",
    "openid-client": "npm:openid-client@6.8.7",
    "pg": "npm:pg@^8.23.0",
    "playwright": "npm:playwright@1.61.1"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  }
}
